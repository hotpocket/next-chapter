# output dirs ignored except generated narration text + transcripts (tracked
# for diffable progress across generations)
**/output/*
!**/output/sections/
!**/output/summaries/
!**/output/chapters.txt
!**/output/site/
**/output/site/*
!**/output/site/transcripts.json
__pycache__/
*.pyc
*.wav
*.mp3
*.m4b
*.m4a
voices/*.wav
!voices/.gitkeep
player/

# Per-repo AUTORUN folders (each is <repo-name>/ with repo/ + output/)
mattpocock-skills/
.gstack/

# Obsidian vault — track shared config + notes, ignore personal/local state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/plugins/
vault/.obsidian/themes/
vault/.obsidian/hotkeys.json
vault/.obsidian/appearance.json
vault/.obsidian/graph.json

# Local pyenv virtualenv pin
.python-version
