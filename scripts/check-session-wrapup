#!/usr/bin/env python3
"""check-session-wrapup — gate the end-of-session publish.

A recap is not the whole deliverable: the same session has to land in the
Session Log, the README sessions table (and its totals), the curated
prompt-history.md index, and any /command it used has to be in
config-history.md's glossary. Each of those is a separate file a human has to
remember; this checks them instead.

Runs against the newest session named in vault/sessions/Session Log.md (row
order is authoritative — filename mtime drifts on touched files).

    scripts/check-session-wrapup [--root DIR]

Exit 0 = every downstream index agrees with the recap + prompts pair on disk.
Exit 1 = drift, with one line per problem. Durable by construction: every count
it compares is re-derived from the prompt files, never from a copied literal.
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

# Slash-command-looking tokens that are filesystem paths, not commands. A
# leading path segment (/tmp/x) is excluded structurally by TOKEN_RE; these are
# the bare-word cases that survive it.
PATH_WORDS = {"tmp", "etc", "usr", "var", "opt", "bin", "dev", "home", "srv", "mnt", "proc"}

# A command reads as "/word" preceded by start-of-line or whitespace, and NOT
# followed by another path segment or a word character.
TOKEN_RE = re.compile(r"(?:^|(?<=\s))/([a-z][a-z-]{1,})(?![\w/-])", re.M)


def repo_root(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).resolve()
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True).stdout.strip()
        return Path(out)
    except Exception:
        return Path.cwd()


def read(p: Path) -> str:
    return p.read_text() if p.exists() else ""


def latest_session(session_log: str) -> str | None:
    """Last [[wikilink]] in the log — rows are appended, so last row wins."""
    links = re.findall(r"\[\[([^\]]+)\]\]", session_log)
    return links[-1] if links else None


def count_prompts(text: str) -> int:
    return len(re.findall(r"^## Prompt \d+", text, re.M))


def claimed_counts(text: str) -> dict[str, int]:
    """slug -> count, from every '[N prompts](.../<slug>-prompts.md)' link."""
    out = {}
    for n, slug in re.findall(r"\[(\d+) prompts?\]\([^)]*?([\w.-]+)-prompts\.md\)", text):
        out[slug] = int(n)
    return out


def totals_claim(text: str) -> tuple[int, int] | None:
    m = re.search(r"(\d+)\s+prompts\s+across\s+(\d+)\s+sessions", text)
    return (int(m.group(1)), int(m.group(2))) if m else None


def main() -> int:
    ap = argparse.ArgumentParser(description="Check that a session's downstream indexes are updated")
    ap.add_argument("--root", default=None)
    args = ap.parse_args()
    root = repo_root(args.root)
    sessions = root / "vault" / "sessions"

    problems: list[str] = []
    log = read(sessions / "Session Log.md")
    if not log:
        print("check-session-wrapup: no vault/sessions/Session Log.md under "
              f"{root} — nothing to check", file=sys.stderr)
        return 1

    name = latest_session(log)
    if not name:
        return fail(["Session Log.md has no [[session]] rows — the newest session "
                     "cannot be identified"])

    recap_p, prompts_p = sessions / f"{name}.md", sessions / f"{name}-prompts.md"
    recap, prompts = read(recap_p), read(prompts_p)

    if not recap:
        problems.append(f"vault/sessions/{name}.md: recap named in Session Log is missing")
    elif f"[[{name}-prompts]]" not in recap:
        problems.append(f"vault/sessions/{name}.md: no [[{name}-prompts]] link — "
                        "the recap must point at its companion export")
    if not prompts:
        problems.append(f"vault/sessions/{name}-prompts.md: prompt export is missing "
                        "(run scripts/export-prompts right after the recap)")
    elif f"[[{name}]]" not in prompts:
        problems.append(f"vault/sessions/{name}-prompts.md: no [[{name}]] link back to the recap")

    actual = {p.name[: -len("-prompts.md")]: count_prompts(read(p))
              for p in sorted(sessions.glob("*-prompts.md"))}

    # README and prompt-history each carry per-session counts and a totals line.
    for rel in ("README.md", "prompt-history.md"):
        text = read(root / rel)
        if not text:
            problems.append(f"{rel}: missing")
            continue
        claimed = claimed_counts(text)
        if name not in claimed:
            problems.append(f"{rel}: no entry for {name} — add the session before publishing")
        for slug, n in claimed.items():
            if slug in actual and n != actual[slug]:
                problems.append(f"{rel}: claims {n} prompts for {slug}, file has {actual[slug]}")
        tot = totals_claim(text)
        if tot is None:
            problems.append(f"{rel}: no 'N prompts across M sessions' totals line")
        else:
            want = (sum(actual.values()), len(actual))
            if tot != want:
                problems.append(f"{rel}: totals say {tot[0]} prompts across {tot[1]} sessions; "
                                f"exports hold {want[0]} across {want[1]}")

    # Every /command in the new export has to be decodable from the glossary.
    glossary = read(root / "config-history.md")
    for cmd in sorted(set(TOKEN_RE.findall(prompts)) - PATH_WORDS):
        if f"/{cmd}" not in glossary:
            problems.append(f"config-history.md: /{cmd} used in {name}-prompts.md "
                            "is not in the command glossary")

    return fail(problems) if problems else ok(name, actual)


def ok(name: str, actual: dict[str, int]) -> int:
    print(f"check-session-wrapup: {name} is fully published — "
          f"{sum(actual.values())} prompts across {len(actual)} sessions, "
          "Session Log / README / prompt-history / glossary all agree")
    return 0


def fail(problems: list[str]) -> int:
    print("check-session-wrapup: wrap-up incomplete", file=sys.stderr)
    for p in problems:
        print(f"  - {p}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
