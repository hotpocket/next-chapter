#!/usr/bin/env bash
# regen-trilogy-audio — regenerate audio + m4a + transcripts for every book in
# the trilogy registry, in registry order. Audio is GPU-bound (Chatterbox TTS)
# and resume-safe: re-running skips chunk WAVs that already exist.
#
# Usage: scripts/regen-trilogy-audio [--registry F] [--repo-story D]
#                                    [--artist S] [--dry-run]
# Env:   PYTHON  interpreter (default python3)
#        VOICE   voice WAV passed to build_audio.py (default: its auto-detect
#                from repo-story/voices/)
#
# After it finishes: python3 scripts/build-trilogy-site, then the owner pushes.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
registry="$repo/scripts/trilogy.json"
rs="$repo/repo-story"
artist="Brandon Landry"
dry=0
PYTHON="${PYTHON:-python3}"

while [ $# -gt 0 ]; do
  case "$1" in
    --registry)   registry="$2"; shift 2 ;;
    --repo-story) rs="$2"; shift 2 ;;
    --artist)     artist="$2"; shift 2 ;;
    --dry-run)    dry=1; shift ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# build_audio.py auto-detects voices/ relative to its CWD — which is the book
# folder, not the repo-story root where voices/ actually lives. Resolve here:
# VOICE env wins; else exactly one wav in <repo-story>/voices/.
if [ -z "${VOICE:-}" ]; then
  wavs=("$rs"/voices/*.wav)
  if [ ${#wavs[@]} -eq 1 ] && [ -e "${wavs[0]}" ]; then
    VOICE="${wavs[0]}"
  elif [ -e "${wavs[0]:-}" ]; then
    echo "ERROR: multiple wavs in $rs/voices/ — set VOICE=<path>" >&2
    exit 1
  else
    echo "ERROR: no wav in $rs/voices/ — set VOICE=<path>" >&2
    exit 1
  fi
fi

slugs="$(python3 -c '
import json, sys
print("\n".join(b["slug"] for b in json.load(open(sys.argv[1]))["books"]))
' "$registry")"

# Preflight every book before burning GPU time on any of them.
for slug in $slugs; do
  out="$rs/$slug/output"
  if [ ! -s "$out/chapters.txt" ]; then
    echo "ERROR: $slug has no $out/chapters.txt — sections not generated?" >&2
    exit 1
  fi
  if ! ls "$out/sections/"section-*.txt >/dev/null 2>&1; then
    echo "ERROR: $slug has no section files in $out/sections/" >&2
    exit 1
  fi
done

run() { # run <bookdir> <cmd...>
  local dir="$1"; shift
  if [ "$dry" = 1 ]; then
    echo "[dry-run] (cd $dir && $PYTHON $*)"
  else
    ( cd "$dir" && "$PYTHON" "$@" )
  fi
}

# Text content hash — no longer a wipe trigger, only the proof that a legacy
# index-keyed cache still lines up with the text that produced it. build_audio.py
# content-addresses chunks now (chNN_<variant>_<sha12>.wav), so an edited
# sentence misses the cache on its own and every other chunk stays a hit; there
# is nothing to wipe. When the hash matches, a legacy cache can be renamed into
# content addressing without re-rendering (chunk_cache.py migrate); when it does
# not, index N no longer means the current chunk N, so migration is unsafe and
# those files are left for the post-build orphan sweep.
text_hash() {
  cat "$1/output/chapters.txt" \
      $(ls "$1"/output/sections/*.txt "$1"/output/summaries/*.txt 2>/dev/null | sort) \
    | sha256sum | cut -c1-64
}

for slug in $slugs; do
  dir="$rs/$slug"
  echo "=== $slug ==="
  hash="$(text_hash "$dir")"
  recorded="$(cat "$dir/output/.text-hash" 2>/dev/null || true)"
  cache_args=(--sections-dir output/sections --summaries-dir output/summaries
              --chunks-dir output/audio/chunks)
  [ -n "${VOICE:-}" ] && cache_args+=(--voice "$VOICE")
  if [ "$hash" = "$recorded" ]; then
    echo "text unchanged — migrating any legacy index-keyed chunks in place"
    run "$dir" ../chunk_cache.py migrate "${cache_args[@]}"
  else
    echo "text changed since last audio build — changed chunks re-render, the rest hit cache"
  fi
  [ "$dry" = 1 ] || mkdir -p "$dir/output/audio/chunks"
  audio_args=(../build_audio.py --title "$slug" --artist "$artist")
  [ -n "${VOICE:-}" ] && audio_args+=(--voice "$VOICE")
  if [ "$dry" = 0 ] && [ -e "$dir/output/book.m4b" ]; then
    # build_audio.py prompts before overwriting an existing M4B; regenerating
    # a derived artifact is this script's purpose, so answer yes.
    ( cd "$dir" && echo y | "$PYTHON" "${audio_args[@]}" )
  else
    run "$dir" "${audio_args[@]}"
  fi
  run "$dir" ../build_m4a.py --title "$slug" --artist "$artist"
  run "$dir" ../build_transcripts.py --slug "$slug"
  # Sweep chunks the current text no longer references (edited-away audio,
  # leftovers from a legacy index-keyed cache). Last: transcripts read chunks.
  run "$dir" ../chunk_cache.py gc "${cache_args[@]}"
  [ "$dry" = 1 ] || echo "$hash" > "$dir/output/.text-hash"
done

echo "All books rebuilt. Next: python3 scripts/build-trilogy-site  (then push when ready)"
